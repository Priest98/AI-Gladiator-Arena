# Circle Developer API Keys
# Get yours at: https://console.circle.com
# Note: CIRCLE_API_KEY is also used for the Arc Testnet faucet (/v1/faucet/drips).
# Your Circle account must have mainnet verification enabled to use the faucet API.
CIRCLE_API_KEY=your_circle_developer_api_key
CIRCLE_WALLET_SET_ID=your_circle_wallet_set_id

# Canteen Arc L1 RPC configuration
# Get your key at: https://thecanteenapp.com
CANTEEN_RPC_KEY=your_canteen_rpc_key

# LLM Combat Strategy Engine (optional)
# Leave blank to use rule-based combat narratives
OPENAI_API_KEY=your_openai_api_key
